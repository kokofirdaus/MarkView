<Window x:Class="MarkView.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalasi MarkView"
        Height="430" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Selamat Datang di Instalasi MarkView" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Modern, Native Windows Markdown Viewer &amp; Editor" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <Separator Margin="0,14,0,0" Background="{StaticResource BorderBrush}"/>
        </StackPanel>

        <!-- 2. Wizard Body (Card) -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
            <!-- State 1: Configuration View -->
            <StackPanel x:Name="PnlConfig">
                <TextBlock Text="Lokasi Pemasangan:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPath" Grid.Column="0" IsReadOnly="True" Padding="8,6" Background="#1E1E1E" Foreground="White" BorderBrush="{StaticResource BorderBrush}"/>
                </Grid>

                <TextBlock Text="Opsi Tambahan:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkDesktopShortcut" Content="Buat pintasan di Desktop" IsChecked="True"/>
                <CheckBox x:Name="ChkStartMenuShortcut" Content="Buat pintasan di Start Menu" IsChecked="True"/>
                <CheckBox x:Name="ChkFileAssociation" Content="Daftarkan sebagai pembuka utama file .md dan .markdown" IsChecked="True"/>

                <TextBlock Text="Ukuran instalasi: ~72 MB (Mandiri, tanpa ketergantungan eksternal)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <!-- State 2: Progress & Finished View (Overlay in Grid.Row 1) -->
        <Border x:Name="PnlProgress" Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Sedang memasang MarkView..." FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ProgressBar x:Name="PrgBar" Height="14" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#1E1E1E" BorderThickness="0" Margin="0,0,0,16"/>
                <CheckBox x:Name="ChkLaunchAfter" Content="Jalankan MarkView setelah instalasi selesai" IsChecked="True" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 3. Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnInstall" Content="Pasang Sekarang" Style="{StaticResource PrimaryBtn}" Click="BtnInstall_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnCancel" Content="Batal" Style="{StaticResource SecondaryBtn}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
