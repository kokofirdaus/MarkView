<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors (Modern GitHub-style Light Standard) -->
    <Color x:Key="AppBackgroundColor">#F6F8FA</Color>
    <Color x:Key="EditorBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PreviewBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ToolbarBackgroundColor">#F6F8FA</Color>
    <Color x:Key="HeaderBackgroundColor">#EAEEF2</Color>
    <Color x:Key="TextPrimaryColor">#1F2328</Color>
    <Color x:Key="TextSecondaryColor">#57606A</Color>
    <Color x:Key="HeadingPrimaryColor">#1F2328</Color>
    <Color x:Key="HeadingSecondaryColor">#0969DA</Color>
    <Color x:Key="HeadingTertiaryColor">#1A7F37</Color>
    <Color x:Key="DividerColor">#D0D7DE</Color>
    <Color x:Key="AccentColor">#0969DA</Color>
    <Color x:Key="AccentHoverColor">#0550AE</Color>
    <Color x:Key="LinkForegroundColor">#0969DA</Color>
    <Color x:Key="CodeBackgroundColor">#F6F8FA</Color>
    <Color x:Key="StatusBarBackgroundColor">#0969DA</Color>
    <Color x:Key="SaveStatusColor">#1A7F37</Color>
    <Color x:Key="ModifiedStatusColor">#BC4C00</Color>

    <!-- Inputs & Dialog Colors -->
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="InputForegroundColor">#1F2328</Color>
    <Color x:Key="InputBorderColor">#D0D7DE</Color>
    <Color x:Key="InputBorderFocusColor">#0969DA</Color>
    <Color x:Key="PopupBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PopupBorderColor">#D0D7DE</Color>
    <Color x:Key="ItemHoverBackgroundColor">#EAEEF2</Color>

    <!-- Table Colors -->
    <Color x:Key="TableHeaderBackgroundColor">#F6F8FA</Color>
    <Color x:Key="TableHeaderForegroundColor">#1F2328</Color>
    <Color x:Key="TableRowAltColor">#F9FAFB</Color>
    <Color x:Key="TableCellBorderColor">#D0D7DE</Color>

    <!-- Blockquote Colors -->
    <Color x:Key="BlockquoteBackgroundColor">#F6F8FA</Color>
    <Color x:Key="BlockquoteBorderColor">#0969DA</Color>
    <Color x:Key="BlockquoteForegroundColor">#57606A</Color>

    <!-- Button Colors -->
    <Color x:Key="ButtonBackgroundColor">#F6F8FA</Color>
    <Color x:Key="ButtonBorderColor">#D0D7DE</Color>
    <Color x:Key="ButtonHoverBackgroundColor">#EAEEF2</Color>
    <Color x:Key="ButtonPressedBackgroundColor">#DDF4FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackgroundColor}"/>
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="{StaticResource PreviewBackgroundColor}"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="{StaticResource ToolbarBackgroundColor}"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="HeadingPrimaryBrush" Color="{StaticResource HeadingPrimaryColor}"/>
    <SolidColorBrush x:Key="HeadingSecondaryBrush" Color="{StaticResource HeadingSecondaryColor}"/>
    <SolidColorBrush x:Key="HeadingTertiaryBrush" Color="{StaticResource HeadingTertiaryColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="LinkForegroundBrush" Color="{StaticResource LinkForegroundColor}"/>
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="{StaticResource CodeBackgroundColor}"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}"/>
    <SolidColorBrush x:Key="SaveStatusBrush" Color="{StaticResource SaveStatusColor}"/>
    <SolidColorBrush x:Key="ModifiedStatusBrush" Color="{StaticResource ModifiedStatusColor}"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="{StaticResource InputForegroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputBorderFocusBrush" Color="{StaticResource InputBorderFocusColor}"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource PopupBackgroundColor}"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{StaticResource PopupBorderColor}"/>
    <SolidColorBrush x:Key="ItemHoverBackgroundBrush" Color="{StaticResource ItemHoverBackgroundColor}"/>

    <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="{StaticResource TableHeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="TableHeaderForegroundBrush" Color="{StaticResource TableHeaderForegroundColor}"/>
    <SolidColorBrush x:Key="TableRowAltBrush" Color="{StaticResource TableRowAltColor}"/>
    <SolidColorBrush x:Key="TableCellBorderBrush" Color="{StaticResource TableCellBorderColor}"/>
    <SolidColorBrush x:Key="BlockquoteBackgroundBrush" Color="{StaticResource BlockquoteBackgroundColor}"/>
    <SolidColorBrush x:Key="BlockquoteBorderBrush" Color="{StaticResource BlockquoteBorderColor}"/>
    <SolidColorBrush x:Key="BlockquoteForegroundBrush" Color="{StaticResource BlockquoteForegroundColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource ButtonBorderColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource ButtonPressedBackgroundColor}"/>

    <!-- Full Light FlowDocument Style for MdXaml Preview -->
    <Style x:Key="MarkdownDocumentStyle" TargetType="FlowDocument">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource PreviewBackgroundBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="PagePadding" Value="24,16"/>

        <Style.Resources>
            <!-- Paragraph & Headings -->
            <Style TargetType="Paragraph">
                <Setter Property="Margin" Value="0,8,0,8"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Heading1">
                        <Setter Property="FontSize" Value="26"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{StaticResource HeadingPrimaryBrush}"/>
                        <Setter Property="Margin" Value="0,18,0,10"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading2">
                        <Setter Property="FontSize" Value="20"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource HeadingSecondaryBrush}"/>
                        <Setter Property="Margin" Value="0,16,0,8"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading3">
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource HeadingSecondaryBrush}"/>
                        <Setter Property="Margin" Value="0,14,0,6"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading4">
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{StaticResource HeadingTertiaryBrush}"/>
                        <Setter Property="Margin" Value="0,12,0,4"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading5">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{StaticResource HeadingTertiaryBrush}"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="Heading6">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="CodeBlock">
                        <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', 'Courier New', monospace"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Background" Value="{StaticResource CodeBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="Margin" Value="0,8,0,8"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="Note">
                        <Setter Property="Margin" Value="0,8,0,8"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Background" Value="{StaticResource CodeBackgroundBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Table -->
            <Style TargetType="Table">
                <Setter Property="CellSpacing" Value="0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource TableCellBorderBrush}"/>
                <Setter Property="Margin" Value="0,12,0,12"/>
            </Style>

            <!-- Table Header -->
            <Style TargetType="TableRowGroup">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="TableHeader">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Background" Value="{StaticResource TableHeaderBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TableHeaderForegroundBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Table Rows (Zebra striping) -->
            <Style TargetType="TableRow">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="EvenTableRow">
                        <Setter Property="Background" Value="{StaticResource TableRowAltBrush}"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="OddTableRow">
                        <Setter Property="Background" Value="{StaticResource PreviewBackgroundBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Table Cells -->
            <Style TargetType="TableCell">
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="BorderBrush" Value="{StaticResource TableCellBorderBrush}"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- Blockquote -->
            <Style TargetType="Section">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Blockquote">
                        <Setter Property="BorderBrush" Value="{StaticResource BlockquoteBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                        <Setter Property="Background" Value="{StaticResource BlockquoteBackgroundBrush}"/>
                        <Setter Property="Padding" Value="14,8,14,8"/>
                        <Setter Property="Margin" Value="0,8,0,8"/>
                        <Setter Property="Foreground" Value="{StaticResource BlockquoteForegroundBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Inline Code -->
            <Style TargetType="Run">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="CodeSpan">
                        <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', 'Courier New', monospace"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Background" Value="{StaticResource CodeBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource HeadingSecondaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Span">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="CodeSpan">
                        <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', 'Courier New', monospace"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Background" Value="{StaticResource CodeBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource HeadingSecondaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Hyperlinks -->
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{StaticResource LinkForegroundBrush}"/>
                <Setter Property="TextDecorations" Value="None"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Separator / Rule -->
            <Style TargetType="BlockUIContainer">
                <Setter Property="Margin" Value="0,12,0,12"/>
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>
