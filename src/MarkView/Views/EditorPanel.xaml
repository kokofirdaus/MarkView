<UserControl x:Class="MarkView.Views.EditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400">
    <Grid Background="{DynamicResource EditorBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="EDITOR" VerticalAlignment="Center" Margin="12,0"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <!-- AvalonEdit TextEditor with theme-aware caret and selection -->
        <avalonedit:TextEditor Grid.Row="1"
                               x:Name="Editor"
                               ShowLineNumbers="{Binding ShowLineNumbers}"
                               WordWrap="{Binding WordWrap}"
                               FontSize="{Binding EditorFontSize}"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               Background="{DynamicResource EditorBackgroundBrush}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               LineNumbersForeground="{DynamicResource TextSecondaryBrush}"
                               Padding="10,8"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
